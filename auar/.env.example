# Copy to .env (never commit .env). All values are read by server/index.ts.
NODE_ENV=production
PORT=8080
DB_FILE=./data/auar.db
PUBLIC_URL=https://your-domain.com

# 1 = demo data, demo sign-in buttons and simulated drivers. Use 0 in production.
AUAR_DEMO=0

# Long random string; tokens are signed with it. Generated and stored in the DB if empty.
AUTH_SECRET=

# Admin dashboard sign-in
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=change-me-to-a-long-password

# SMS for sign-in codes: console | unifonic | twilio
SMS_PROVIDER=console
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Card payments for wallet top-ups: mock | moyasar
PAYMENTS_PROVIDER=mock
MOYASAR_SECRET_KEY=

# Allowed origin for the API (mobile apps / other domains)
CORS_ORIGIN=*
